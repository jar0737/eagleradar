# Line endings: the repository always stores text files with LF, whatever the
# OS or Git settings of the person committing. On checkout, each OS gets its
# native line endings (CRLF on Windows with core.autocrlf=true, LF elsewhere).
* text=auto

# Files read inside Linux containers or by shells must stay LF everywhere
*.sh   text eol=lf
*.sql  text eol=lf
Dockerfile text eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never convert, never show a text diff
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.pdf     binary
*.zip     binary
*.gpkg    binary
*.parquet binary
*.pbf     binary
