# Copy to .env and fill in. Never commit .env.

# Bluesky (optional live import). Use an app password, not your main password:
# Bluesky → Settings → Privacy and security → App passwords
BSKY_HANDLE=your-handle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Online geocoding fallback via Nominatim (OpenStreetMap). 0 = gazetteer only.
GEOCODER_ONLINE=0
# Nominatim requires a meaningful user agent with contact info
GEOCODER_USER_AGENT=eagleradar (student project, contact: you@example.org)

# Salt for pseudonymizing author names (any random string)
PSEUDONYM_SALT=change-me
